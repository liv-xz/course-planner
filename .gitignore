# ============================================================
# 只跟踪前后端代码（backend/ + frontend/），其余一律不提交
# ============================================================
/*
!/.gitignore
!/backend/
!/frontend/

# ===== 后端构建产物 / 可执行文件 =====
/backend/bin/
/backend/*.exe
*.exe

# ===== 本地配置（含密码 / API Key，不提交） =====
/backend/configs/config.yaml
/backend/configs/config.local.yaml

# ===== 日志 =====
/backend/logs/
*.log

# ===== 前端依赖 / 构建 =====
/frontend/node_modules/
/frontend/dist/

# ===== 环境 / IDE =====
.env
.env.*
.idea/
.vscode/

# ===== 系统 =====
Thumbs.db
.DS_Store
